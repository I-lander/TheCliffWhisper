    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "electron": "^32.2.8",
    "electron-builder": "^22.11.7",
    "electron-rebuild": "^3.2.9",
    "electron-updater": "^6.3.9",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "packagerConfig": {
    "icon": "./assets/icon"
